  },
  "gradient": {
    "primary": {
      "$type": "gradient",
      "$value": [
        {
          "color": "{color.cyan.500}",
          "position": 0
        },
        {
          "color": "{color.cyan.300}",
          "position": 1
        }
      ]
    },
    "signal": {
      "$type": "gradient",
      "$value": [
        {
          "color": "{color.cyan.500}",
          "position": 0
        },
        {
          "color": "{color.green.400}",
          "position": 0.5
        },
        {
          "color": "{color.coral.400}",
          "position": 1
        }
      ]
    }
  },
  "font": {
    "sans": {
      "$type": "fontFamily",
      "$value": [
        "Geist Variable",
        "Geist",
        "ui-sans-serif",
        "system-ui",
        "sans-serif"
      ]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": [
        "Geist Mono Variable",
        "Geist Mono",
        "ui-monospace",
        "SFMono-Regular",
        "Menlo",
        "monospace"
      ]
    }
  },
  "typography": {
    "display": {
      "$type": "typography",
      "$description": "Hero headline, one per page",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "72px",
        "fontWeight": 600,
        "lineHeight": 1.05,
        "letterSpacing": "-0.04em"
      }
    },
    "h1": {
      "$type": "typography",
      "$description": "Section titles",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "56px",
        "fontWeight": 600,
        "lineHeight": 1.08,
        "letterSpacing": "-0.035em"
      }
    },
    "h2": {
      "$type": "typography",
      "$description": "Sub-sections, product names",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "40px",
        "fontWeight": 600,
        "lineHeight": 1.12,
        "letterSpacing": "-0.03em"
      }
    },
    "h3": {
      "$type": "typography",
      "$description": "Card titles",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "28px",
        "fontWeight": 600,
        "lineHeight": 1.2,
        "letterSpacing": "-0.02em"
      }
    },
    "h4": {
      "$type": "typography",
      "$description": "Small headings, list titles",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "20px",
        "fontWeight": 600,
        "lineHeight": 1.3,
        "letterSpacing": "-0.01em"
      }
    },
    "body-lg": {
      "$type": "typography",
      "$description": "Lead paragraphs",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "18px",
        "fontWeight": 400,
        "lineHeight": 1.6,
        "letterSpacing": "0em"
      }
    },
    "body": {
      "$type": "typography",
      "$description": "Default copy",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "16px",
        "fontWeight": 400,
        "lineHeight": 1.6,
        "letterSpacing": "0em"
      }
    },
    "small": {
      "$type": "typography",
      "$description": "Captions, helper text",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "14px",
        "fontWeight": 400,
        "lineHeight": 1.5,
        "letterSpacing": "0em"
      }
    },
    "label": {
      "$type": "typography",
      "$description": "Eyebrows, tags, nav",
      "$value": {
        "fontFamily": "{font.mono}",
        "fontSize": "12px",
        "fontWeight": 500,
        "lineHeight": 1.4,
        "letterSpacing": "0.12em",
        "textTransform": "uppercase"
      }
    },
    "code": {
      "$type": "typography",
      "$description": "Code, CVE IDs, endpoints, metrics",
      "$value": {
        "fontFamily": "{font.mono}",
        "fontSize": "14px",
        "fontWeight": 400,
        "lineHeight": 1.6,
        "letterSpacing": "0em"
      }
    }
  }
}
