      "$description": "Severity/state colors for product UI only. Never branding.",
      "critical": {
        "$type": "color",
        "$value": "#EF4444"
      },
      "high": {
        "$type": "color",
        "$value": "#F97316"
      },
      "medium": {
        "$type": "color",
        "$value": "#F59E0B"
